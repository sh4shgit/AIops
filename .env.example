# =============================================================================
# AIOps Assistant Configuration
# Copy to .env and fill in values
# =============================================================================

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=logs:incoming
REDIS_CONSUMER_GROUP=aiops-workers
REDIS_DLQ_STREAM=logs:dead-letter
REDIS_MAX_RETRIES=3

# --- Vector Store ---
VECTOR_STORE_BACKEND=chromadb
# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=incidents
# pgvector (optional)
PGVECTOR_URL=postgresql://user:password@localhost:5432/aiops

# --- Embedding ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5

# --- Detection ---
ANOMALY_HIGH_THRESHOLD=-0.3
ANOMALY_LOW_THRESHOLD=-0.1
ISOLATION_FOREST_CONTAMINATION=0.05
ISOLATION_FOREST_N_ESTIMATORS=200
FEATURE_WINDOW_SECONDS=300
MODEL_ARTIFACT_DIR=./data/models

# --- Actions ---
DRY_RUN=true
JIRA_URL=https://your-org.atlassian.net
JIRA_USER=bot@your-org.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#alerts

# --- API ---
API_KEY=changeme
RATE_LIMIT_PER_MINUTE=60
API_HOST=0.0.0.0
API_PORT=8000

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_ENABLED=true
